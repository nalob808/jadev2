{
  "name": "jade",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "fixtures": "python3 scripts/generate_fixtures.py",
    "places:import": "tsx scripts/load-places.ts",
    "db:migrate": "pnpm --filter @jade/db run migrate",
    "db:seed": "pnpm --filter @jade/db run seed",
    "db:doctor": "pnpm --filter @jade/db run doctor",
    "db:app-role": "pnpm --filter @jade/db run app-role"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.1",
    "tsx": "^4.19.1"
  },
  "type": "module"
}
