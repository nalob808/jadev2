node_modules/
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo

# secrets — never commit
# Every env file except the template. The narrower rules this replaces let
# .env.testpaste — which held a live DATABASE_URL — be committed.
.env
.env.*
!.env.example

# ephemeris data files are fetched by scripts/fetch-ephe.ts, never committed (~100MB)
.ephe/
*.se1

.DS_Store
playwright-report/
test-results/

# Scratch drop for files the remote sandbox could not delete
_to_delete/

# Screenshots from verification runs belong in the session, not the repo
/*.png
/apps/*/*.png
/packages/*/*.png
docs/email-templates/*.preview.html
