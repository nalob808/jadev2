# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit the filled-in file.
# Every variable here is explained in the Jade Setup Manual.
# ---------------------------------------------------------------------------

# --- Database (Neon or Supabase) -------------------------------------------
DATABASE_URL="postgresql://user:pass@host/jade?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@host/jade?sslmode=require"

# --- Auth (Supabase) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments (Stripe) — test keys until you launch -------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Jade <hello@yourdomain.com>"

# --- Errors (Sentry) --------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Analytics (PostHog) — birth data is never sent -------------------------
NEXT_PUBLIC_POSTHOG_KEY=""

# --- Ephemeris --------------------------------------------------------------
# Path to Swiss Ephemeris data files. Leave blank to use the built-in
# Moshier model (no data files, slightly lower precision).
EPHE_PATH=".ephe"

# Which provider computes stored charts: "astronomy-engine" (MIT, no licence
# needed) or "swisseph" (requires the CHF 700 professional licence for
# commercial use). Start with astronomy-engine.
EPHEMERIS_PROVIDER="astronomy-engine"

# --- Encryption -------------------------------------------------------------
# 32-byte base64 key for birth-data encryption at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
