# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit the filled-in file.
# Every variable here is explained in the Jade Setup Manual.
# ---------------------------------------------------------------------------

# --- Database (Neon or Supabase) -------------------------------------------
DATABASE_URL="postgresql://user:pass@host/jade?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@host/jade?sslmode=require"

# --- Auth -------------------------------------------------------------------
# "dev"      sign in with any email, no password, no external service. Lets
#            you run the whole app against a database alone. REFUSES to start
#            in production.
# "supabase" real sign-in. Needs the three keys below.
AUTH_MODE="dev"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Payments (Stripe) — test keys until you launch -------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Jade <hello@yourdomain.com>"

# --- Errors (Sentry) --------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Analytics (PostHog) — birth data is never sent -------------------------
NEXT_PUBLIC_POSTHOG_KEY=""

# --- Ephemeris --------------------------------------------------------------
# Path to Swiss Ephemeris data files. Leave blank to use the built-in
# Moshier model (no data files, slightly lower precision).
EPHE_PATH=".ephe"

# Which provider computes stored charts: "astronomy-engine" (MIT, no licence
# needed) or "swisseph" (requires the CHF 700 professional licence for
# commercial use). Start with astronomy-engine.
EPHEMERIS_PROVIDER="astronomy-engine"

# --- Encryption -------------------------------------------------------------
# 32-byte base64 key for birth-data encryption at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Billing (Stripe) -------------------------------------------------------
# All optional. With these unset the app runs normally, the upgrade wall offers
# to record interest instead of taking a card, and the Stripe SDK is never
# loaded. Set them only once the products below exist — see docs/09-stripe.md.
#
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… while testing)
STRIPE_SECRET_KEY=""
# Signing secret for your webhook endpoint (whsec_…). NOT the API key.
STRIPE_WEBHOOK_SECRET=""
#
# One price id per tier per interval. A tier with no price id here simply
# cannot be bought, and the wall falls back to "tell me when this opens" for
# it — so it is safe to add these one tier at a time.
STRIPE_PRICE_SEEKER_MONTHLY=""
STRIPE_PRICE_SEEKER_YEARLY=""
STRIPE_PRICE_PRACTITIONER_MONTHLY=""
STRIPE_PRICE_PRACTITIONER_YEARLY=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_YEARLY=""

# --- Tests ------------------------------------------------------------------
# Database integration and end-to-end tests skip unless this is set. The role
# must NOT be a superuser — superusers bypass row-level security, and a test
# that passes because the check was skipped is worse than no test.
TEST_DATABASE_URL=""

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3100"
